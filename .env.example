# ============================================================
# Plantilla de variables de entorno - copiala a `.env`
# ------------------------------------------------------------
# cp .env.example .env
#
# NOTA: `.env` NO se sube a git y NO entra a la imagen Docker
# (.gitignore y .dockerignore). En PRODUCCION el `DATABASE_URL`
# (y demas variables) las inyecta la plataforma de deploy como
# variables de entorno del contenedor (ej. Dokploy), asi que lo
# que pongas aqui en local JAMAS afecta al despliegue.
# ============================================================

# --- Base de datos ---
# Desarrollo (PostgreSQL local con Homebrew: brew services start postgresql@14)
DATABASE_URL="postgresql://prograficos:user@domain:5432/su_bd"

# Produccion (solo referencia, la plataforma la inyecta al contenedor)
# DATABASE_URL="postgresql://andreslara:andreslara@152.53.91.93:5444/prograficos_andres"

# --- MongoDB (almacen de documentos: cotizaciones, etc.) ---
# Desarrollo (contenedor Docker: docker run -d --name mongo-prograficos -p 27017:27017 mongo:8)
MONGO_URI="mongodb://127.0.0.1:27017/name_db"
# Produccion (EasyPanel: servicio Mongo aparte, con auth y red interna; la plataforma la inyecta)
# MONGO_URI="mongodb://usuario:password@<servicio-mongo>:27017/prograficos_documents?authSource=admin"

# --- App ---
NODE_ENV="development"
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1d"

# --- CORS (origenes separados por coma) ---
# DEVELOPMENT
CORS_ORIGIN_DEVELOPMENT=http://localhost:5173,http://localhost:5174
# PRODUCTION
# CORS_ALLOWED_ORIGINS=https://prograficos.opita.dev

# --- Socket.IO ---
SOCKET_IO_PATH=/socket.io

# --- Cloudflare R2 (almacenamiento de imágenes de troquel, bucket PRIVADO) ---
# Endpoint del bucket: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# TTL (segundos) de las URLs firmadas para mostrar imágenes. Default 3600 (1h).
R2_SIGNED_URL_TTL=3600

# --- Administrador inicial (usado por `npm run seed:admin`) ---
# Crea/asegura un unico usuario ADMIN sin credenciales quemadas en el repo.
# En PRODUCCION define estas variables en la plataforma y corre `npm run seed:admin`.
ADMIN_EMAIL=tu-usuario-admin@dominio.com
ADMIN_PASSWORD=cambia-esta-contrasena
# Opcionales:
# ADMIN_NAME=Administrador
# ADMIN_SURENAME=Prográficos
