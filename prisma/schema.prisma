generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  ADMIN
  SUPERVISOR
  EMPLOYEE
  USER
}

enum Thirds_type {
  CLIENTE
  PROVEEDOR
  OTROS
}

enum Person_Type {
  NATURAL
  JURIDICA
}

enum Document_Type {
  NIT
  CC
  CE
  PASAPORTE
}

enum Size {
  SMALL
  MEDIUM
  LARGE
}

enum Order_Status {
  PENDIENTE
  EN_PROCESO
  TERMINADO
  ENTREGADO
}

enum Process_State {
  PENDIENTE
  EN_PROCESO
  TERMINADO
}

enum Process_Category {
  PREPRENSA
  CORTE
  IMPRESION
  ACABADO
  TROQUELADO
  PEGADO
  EMPAQUE
  OTRO
}

enum Field_Type {
  TEXT
  TEXTAREA
  NUMBER
  BOOLEAN
  DATE
  TIME
  SELECT
}

enum Machinery_Type {
  PREPRENSA
  GUILLOTINA
  IMPRESORA_OFFSET
  IMPRESORA_DIGITAL
  PLASTIFICADORA
  LAMINADORA
  BARNIZADORA
  ESTAMPADORA
  TROQUELADORA
  PEGADORA
  DOBLADORA
  EMPAQUE
  OTRA
}

//////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////

model User {
  id        Int      @id @default(autoincrement())
  name      String
  surename  String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  avatar    String?  @default("https://img.freepik.com/vector-premium/icono-perfil-avatar-predeterminado-imagen-usuario-redes-sociales-icono-avatar-gris-silueta-perfil-blanco-ilustracion-vectorial_561158-3383.jpg")

  is_active Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  header_production_orders Header_Production_Order[]
  user                     Detail_Production_Order[] @relation("UserDetails")

  @@map("users")
}

//////////////////////////////////////////////////////
// PROCESS
//////////////////////////////////////////////////////

model Process {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  order    Int
  category Process_Category @default(OTRO)

  is_active Boolean @default(true)

  detail_production_orders Detail_Production_Order[]
  field_definitions        Process_Field_Definition[]
  machineries              ProcessMachinery[]

  @@map("processes")
}

model Process_Field_Definition {
  id          Int        @id @default(autoincrement())
  key         String
  label       String
  field_type  Field_Type
  is_required Boolean    @default(false)
  diligenciar_en_detalle Boolean @default(false)
  sort_order  Int
  options     Json?
  process_id  Int
  deleted_at  DateTime?

  process      Process                     @relation(fields: [process_id], references: [id])
  field_values Detail_Process_Field_Value[]

  @@unique([process_id, key])
  @@map("process_field_definitions")
}

//////////////////////////////////////////////////////
// PROCESS MACHINERY (junction)
//////////////////////////////////////////////////////

model ProcessMachinery {
  id           Int        @id @default(autoincrement())
  process_id   Int
  machinery_id Int?

  process   Process    @relation(fields: [process_id], references: [id], onDelete: Cascade)
  machinery Machinery? @relation(fields: [machinery_id], references: [id], onDelete: SetNull)

  @@map("process_machinery")
}

//////////////////////////////////////////////////////
// MACHINERY
//////////////////////////////////////////////////////

model Machinery {
  id        Int     @id @default(autoincrement())
  name      String
  reference String  @unique
  type      Machinery_Type

  is_active Boolean @default(true)

  detail_production_orders Detail_Production_Order[] @relation("MachineryDetails")
  process_machineries ProcessMachinery[]

  @@map("machinery")
}

//////////////////////////////////////////////////////
// FORMAT
//////////////////////////////////////////////////////

model Format {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  sheet_divisions Int @default(1)

  is_active Boolean @default(true)

  measures Measure[]

  @@map("formats")
}

//////////////////////////////////////////////////////
// MEASURE
//////////////////////////////////////////////////////

model Measure {
  id        Int   @id @default(autoincrement())
  width     Float
  height    Float
  format_id Int

  is_active Boolean @default(true)

  format Format @relation(fields: [format_id], references: [id])

  header_production_orders Header_Production_Order[]
  cutting_details          Detail_Production_Order[] @relation("MeasureCutting")

  @@map("measures")
}

//////////////////////////////////////////////////////
// PAPER TYPES
//////////////////////////////////////////////////////

model Paper_Type {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  grammage    Float

  is_active Boolean @default(true)

  header_production_orders Header_Production_Order[]
  suppliers                PaperTypeSupplier[]

  @@map("paper_types")
}

//////////////////////////////////////////////////////
// THIRDS
//////////////////////////////////////////////////////

model Thirds {
  id           Int          @id @default(autoincrement())
  name         String
  email        String?      @unique
  address      String?
  type_person  Thirds_type? @default(CLIENTE)
  person_type  Person_Type?
  document_type Document_Type?
  document_number String?
  company_name String?

  is_active Boolean @default(true)

  products Product[]
  paper_type_suppliers PaperTypeSupplier[]

  @@unique([document_type, document_number])
  @@map("thirds")
}

model PaperTypeSupplier {
  id             Int     @id @default(autoincrement())
  third_id       Int
  paper_type_id  Int
  purchase_price Decimal @db.Decimal(12, 2)

  third      Thirds     @relation(fields: [third_id], references: [id])
  paper_type Paper_Type @relation(fields: [paper_type_id], references: [id])

  @@unique([paper_type_id, third_id])
  @@map("paper_type_suppliers")
}

//////////////////////////////////////////////////////
// PRODUCT
//////////////////////////////////////////////////////

model Product {
  id         Int @id @default(autoincrement())
  name       String?
  troquel_id Int
  third_id   Int

  is_active Boolean @default(true)

  troquel Troqueles @relation(fields: [troquel_id], references: [id])
  third   Thirds    @relation(fields: [third_id], references: [id])

  header_production_orders Header_Production_Order[]

  @@map("products")
}

//////////////////////////////////////////////////////
// TROQUELES
//////////////////////////////////////////////////////

model Troqueles {
  id               Int      @id @default(autoincrement())
  elaboration_date DateTime @default(now())
  code             String?
  size             Size
  file_name        String? 
  file             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime  @default(now())

  is_active Boolean @default(true)

  header_production_orders Header_Production_Order[]
  products                 Product[]

  @@unique([size, code])
  @@map("troqueles")
}

//////////////////////////////////////////////////////
// HEADER PRODUCTION ORDER
//////////////////////////////////////////////////////

model Header_Production_Order {
  id                      Int          @id @default(autoincrement())
  date                    DateTime     @default(now())
  date_delivery_estimated DateTime?
  order_status            Order_Status @default(PENDIENTE)
  is_active               Boolean      @default(true)

  amount_sheets          Int
  amount_sheets_additional Int @default(0)
  cavities               Int @default(1)
  total_estimated        Int
  total_delivered        Int?
  total_damaged          Int?

  measure_id          Int
  paper_type_id       Int
  troquel_id          Int
  product_id          Int
  user_id             Int

  measure    Measure    @relation(fields: [measure_id], references: [id])
  paper_type Paper_Type @relation(fields: [paper_type_id], references: [id])
  troquel    Troqueles  @relation(fields: [troquel_id], references: [id])
  product    Product    @relation(fields: [product_id], references: [id])
  user       User       @relation(fields: [user_id], references: [id])

  detail_production_orders Detail_Production_Order[]

  @@map("header_production_orders")
}

//////////////////////////////////////////////////////
// DETAIL PRODUCTION ORDER
//////////////////////////////////////////////////////

model Detail_Production_Order {
  id Int @id @default(autoincrement())

  start_date DateTime?
  end_date   DateTime?

  start_hour DateTime?
  end_hour   DateTime?

  process_state Process_State @default(PENDIENTE)

  quantity_delivered Int
  quantity_damaged   Int

  observations String?

  header_order_id    Int
  process_id         Int
  user_id            Int?
  machinery_id       Int?
  measure_cutting_id Int?

  header_order Header_Production_Order @relation(fields: [header_order_id], references: [id])
  process      Process                 @relation(fields: [process_id], references: [id])

  measure_cutting Measure? @relation("MeasureCutting", fields: [measure_cutting_id], references: [id])
  user            User?    @relation("UserDetails", fields: [user_id], references: [id])
  machinery       Machinery? @relation("MachineryDetails", fields: [machinery_id], references: [id])
  field_values    Detail_Process_Field_Value[]

  @@map("detail_production_orders")
}

model Detail_Process_Field_Value {
  id                         Int    @id @default(autoincrement())
  value                      String
  detail_production_order_id Int
  field_definition_id        Int

  detail           Detail_Production_Order   @relation(fields: [detail_production_order_id], references: [id])
  field_definition Process_Field_Definition @relation(fields: [field_definition_id], references: [id])

  @@unique([detail_production_order_id, field_definition_id])
  @@map("detail_process_field_values")
}
